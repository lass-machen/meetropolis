{
  "name": "@meetropolis/web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit && npm run typecheck:e2e",
    "typecheck:e2e": "tsc -p tsconfig.lint.json",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "test": "vitest run --reporter=verbose",
    "check:av": "vite build && vitest run --reporter=verbose src/lib/livekit.test.ts src/av/core/TrackManager.concurrency.test.ts src/av/core/TrackManager.signalClosed.test.ts src/av/features/DoNotDisturb.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "node ./e2e-run.js",
    "e2e:probe": "MT_PROBE=1 playwright test --workers=1"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.49",
    "@colyseus/sdk": "^0.18.10",
    "@meetropolis/shared": "*",
    "@radix-ui/primitive": "^1.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-portal": "^1.2.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "altcha-lib": "^2.9.0",
    "aria-hidden": "^1.2.6",
    "detect-node-es": "^1.1.0",
    "get-nonce": "^1.0.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "jszip": "^3.10.2",
    "livekit-client": "^2.24.1",
    "lucide-react": "^1.74.0",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.15",
    "tinyrainbow": "^3.2.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "4.14.1",
    "es-module-lexer": "^3.0.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "livekit-server-sdk": "^2.20.0",
    "pg": "^8.23.1",
    "typescript": "^6.0.3",
    "vite": "~8.3.8",
    "vitest": "^5.1.1"
  }
}
