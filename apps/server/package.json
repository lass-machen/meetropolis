{
  "name": "@meetropolis/server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "predev": "prisma generate --schema=./prisma/schema.prisma && prisma db push --schema=./prisma/schema.prisma && prisma db seed --schema=./prisma/schema.prisma",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node ./scripts/copy-generated.mjs && node ./scripts/copy-catalog.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.seed.json && tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "test": "vitest run --project server",
    "test:db": "vitest run --project server-db --project server-db-exclusive",
    "map:import:v2": "tsx src/scripts/importMapV2.ts",
    "map:atelier:migrate": "tsx src/scripts/migrateAtelierStandardMap.ts",
    "map:autotiles:migrate": "tsx src/scripts/migrateAutotilePalettes.ts",
    "map:collision-sources:migrate": "tsx src/scripts/migrateCollisionSources.ts",
    "avatar:rerender": "tsx src/scripts/rerenderCustomAvatars.ts",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --name init --schema=./prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=./prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema=./prisma/schema.prisma",
    "start:dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.29",
    "@colyseus/redis-driver": "^0.18.7",
    "@colyseus/redis-presence": "^0.18.6",
    "@colyseus/schema": "^5.0.50",
    "@colyseus/sdk": "^0.18.10",
    "@colyseus/ws-transport": "^0.18.5",
    "@meetropolis/shared": "*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "altcha-lib": "^2.10.0",
    "bcryptjs": "^3.0.3",
    "c12": "^3.3.4",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "effect": "^3.22.2",
    "empathic": "^2.1.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "fast-check": "^4.11.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jiti": "^2.7.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.20.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pathe": "^2.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pngjs": "^7.0.0",
    "prom-client": "^15.1.3",
    "pure-rand": "^8.4.2",
    "rate-limit-redis": "^6.0.2",
    "unzipper": "^0.12.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@livekit/rtc-node": "^1.2.3",
    "@playwright/test": "^1.65.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.21.0",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^7.2.1",
    "jszip": "^3.10.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
