{
  "name": "@meetropolis/asset-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "assets": "node --experimental-strip-types scripts/export-assets.ts",
    "assets:product": "node --experimental-strip-types scripts/run-product-export.ts",
    "assets:check": "node --experimental-strip-types scripts/run-product-export.ts --check",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "jszip": "3.10.2",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/pngjs": "6.0.5",
    "eslint": "10.10.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "zod": "4.6.4"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.7.0"
  },
  "packageManager": "npm@11.7.0"
}
