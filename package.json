{
  "name": "meetropolis",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.7.0"
  },
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "npm --workspace=@meetropolis/web run dev",
    "dev:server": "npm --workspace=@meetropolis/server run dev",
    "lint": "npm run lint:eslint && npm run lint:budgets && npm run lint:stats",
    "lint:eslint": "eslint .",
    "lint:budgets": "node scripts/enforce-budgets.js",
    "lint:stats": "node scripts/lint-stats.cjs",
    "lint:stats:update": "node scripts/lint-stats.cjs --update",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run -ws --if-present typecheck",
    "build": "npm -w @meetropolis/web run build && npm -w @meetropolis/server run build",
    "generate": "npm -w @meetropolis/server run prisma:generate",
    "map:atelier:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tools/map-builder/build_atelier_map.ts",
    "ci:local": "bash scripts/ci-local.sh",
    "prisma:migrate": "npm -w @meetropolis/server run prisma:migrate",
    "dev:loadtest": "npm -w @meetropolis/loadtest run dev",
    "prepare": "node -e \"require('node:fs').existsSync('scripts/install-hooks.cjs')&&require('./scripts/install-hooks.cjs')\""
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "stylelint": "17.16.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "ip-address": "^10.7.2",
    "ws": "^8.21.0",
    "@hono/node-server": "^1.19.14",
    "@prisma/dev": {
      "@hono/node-server": "^1.19.14"
    }
  }
}
